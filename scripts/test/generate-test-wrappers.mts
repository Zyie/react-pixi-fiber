import fs from 'node:fs';
import path from 'node:path';

import type { Plugin } from 'vitest/config';

const MARKER = '// Auto-generated by scripts/test/generate-test-wrappers.mts, do not edit manually';

/** One kind of file that gets a generated test wrapper */
export interface WrapperKind {
  /** Folder that holds the files, with its subfolders */
  dir: string;
  /** What ends the name of such a file, such as `.scene.tsx` */
  suffix: RegExp;
  /** The function of `@test-utils` the wrapper calls with the file's key and its export */
  define: string;
  /** The name the file exports its content under */
  exportName: string;
  /** Folder the wrappers are written to, in the same subfolders as their files; beside each file when omitted */
  outDir?: string;
  /** What starts every key, such as `docs/` */
  keyPrefix?: string;
}

/** Where the references of scenes are, from the repo root */
const SNAPSHOTS = 'tests/snapshots';

/** What follows a scene's key in the name of each of its references */
const REFERENCE = /\.(webgl|webgpu|three)\.png$/;

/**
 * Every file under a folder whose name matches a pattern
 * @param dir - Folder to search, with its subfolders; it may be missing
 * @param pattern - Tested against the path of each file under the folder
 */
function findFiles(dir: string, pattern: RegExp): string[] {
  if (!fs.existsSync(dir)) return [];

  return fs
    .readdirSync(dir, { recursive: true, encoding: 'utf8' })
    .filter((file) => pattern.test(file))
    .map((file) => path.join(dir, file));
}

/**
 * The key of a file: its path under the folder of its kind without the suffix, after the kind's
 * prefix. `tests/scenes/core/use-frame.scene.tsx` is `core/use-frame`, which names its references and
 * its failure pictures.
 * @param file - Absolute path of the file
 * @param root - Absolute path of the folder of its kind
 * @param kind - The kind of file
 */
const keyOf = (file: string, root: string, kind: WrapperKind): string =>
  `${kind.keyPrefix ?? ''}${path.relative(root, file).split(path.sep).join('/').replace(kind.suffix, '')}`;

/**
 * The wrapper for one file, which imports the file and calls the kind's `define` with its key
 * @param wrapper - Absolute path of the wrapper
 * @param file - Absolute path of the file
 * @param key - The file's key
 * @param kind - The kind of file
 */
function wrapperFor(wrapper: string, file: string, key: string, kind: WrapperKind): string {
  const relative = path
    .relative(path.dirname(wrapper), file)
    .split(path.sep)
    .join('/')
    .replace(/\.tsx?$/, '');

  return [
    MARKER,
    `import { ${kind.define} } from '@test-utils';`,
    ``,
    `import { ${kind.exportName} } from '${relative.startsWith('.') ? relative : `./${relative}`}';`,
    ``,
    `${kind.define}('${key}', ${kind.exportName});`,
    ``,
  ].join('\n');
}

/**
 * Writes one wrapper for every file of each kind, so each is a test file of its own: vitest runs files
 * in parallel, not the tests inside one. A wrapper is named after its file, with `.test.ts` in place of
 * the extension: `use-frame.scene.test.ts` for `use-frame.scene.tsx`, beside it or in the kind's `outDir`.
 *
 * The wrappers are gitignored and brought up to date on every vitest start. A missing or stale one
 * is written, and one whose source is gone is deleted. Only files that start with the generator's
 * marker are ever deleted.
 *
 * It then holds `tests/snapshots` to the keys, and throws, naming each, when a reference has no file
 * whose test compares it.
 * @param kinds - The kinds of file to wrap
 */
export default function generateTestWrappers(kinds: readonly WrapperKind[]): Plugin {
  const keys = new Set<string>();

  for (const kind of kinds) {
    const root = path.resolve(kind.dir);
    const out = path.resolve(kind.outDir ?? kind.dir);
    const wanted = new Set<string>();

    for (const file of findFiles(root, kind.suffix)) {
      const key = keyOf(file, root, kind);
      const wrapper = path.join(out, path.relative(root, file)).replace(/\.tsx?$/, '.test.ts');
      const content = wrapperFor(wrapper, file, key, kind);

      keys.add(key);
      wanted.add(wrapper);
      fs.mkdirSync(path.dirname(wrapper), { recursive: true });
      if (!fs.existsSync(wrapper) || fs.readFileSync(wrapper, 'utf8') !== content) fs.writeFileSync(wrapper, content);
    }

    for (const wrapper of findFiles(out, /\.test\.ts$/)) {
      if (!wanted.has(wrapper) && fs.readFileSync(wrapper, 'utf8').startsWith(MARKER)) fs.unlinkSync(wrapper);
    }
  }

  const snapshots = path.resolve(SNAPSHOTS);
  const orphans = findFiles(snapshots, REFERENCE).filter(
    (reference) => !keys.has(path.relative(snapshots, reference).split(path.sep).join('/').replace(REFERENCE, '')),
  );

  if (orphans.length > 0) {
    throw new Error(
      `No scene compares these references; delete them, or bring back the scene:\n  ${orphans
        .map((file) => path.relative(process.cwd(), file))
        .join('\n  ')}`,
    );
  }

  return { name: 'vitest:generate-test-wrappers' };
}
