{
  // An app's view of the built packages: their declarations in dist, found through node_modules and each
  // package's exports as an app finds them, type-checked with TypeScript's default skipLibCheck (false),
  // so an error in them fails `npm run test:bundle`.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["@types/web"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "files": ["app.tsx"]
}
