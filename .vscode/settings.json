{
  "typescript.preferences.autoImportFileExcludePatterns": ["packages/*/src/*/**/index.ts", "packages/*/src/index.ts"],
  "typescript.preferences.autoImportSpecifierExcludeRegexes": ["~threejs-compat/.*", "@react-fiber/r3f/.*"],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
