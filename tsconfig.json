{
  // Everything at once: the packages, the tests, the examples, the playground and the scripts, but for the native
  // folders, which tsconfig.native.json checks. Each package's own tsconfig.json checks it alone, against only
  // the packages it depends on (`npm run test:types` runs all of them).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@react-fiber/core": ["./packages/core/src/index.tsx"],
      "@react-fiber/core/extension": ["./packages/core/src/extension.ts"],
      "@react-fiber/2d": ["./packages/2d/src/index.ts"],
      "@react-fiber/3d": ["./packages/3d/src/index.ts"],
      "@react-fiber/threejs-compat": ["./packages/threejs-compat/src/index.ts"],
      "@react-fiber/threejs-compat/three": ["./packages/threejs-compat/src/three.ts"],
      "@react-fiber/threejs-compat/addons": ["./packages/threejs-compat/src/addons/index.ts"],
      "@react-fiber/r3f/*": ["./packages/r3f/*"],
      "#types": ["./packages/r3f/types/index.ts"],
      "#types/*": ["./packages/r3f/types/*"],
      // Unit tests reach threejs-compat's internals, which no entry exports.
      "~threejs-compat/*": ["./packages/threejs-compat/src/*"],
      "@test-scene": ["./tests/harness/scene.ts"],
      "@test-utils": ["./tests/harness/test-utils.tsx"]
    }
  },
  "include": ["packages/*/src", "tests", "examples", "playground", "scripts", "*.config.ts"],
  // packages/r3f is type-checked through what core imports from it. Its own entries (index, legacy, webgpu)
  // each declare three's JSX elements, which would clash with ours. The docs site has its own tsconfig.json.
  // The native folders are tsconfig.native.json's: threejs-compat, in this program, registers three's
  // classes for every root, and they run without it.
  "exclude": [
    "node_modules",
    "**/dist",
    "packages/r3f/**",
    "packages/docs/**",
    "tests/scenes/3d",
    "tests/unit/native",
    "tests/docs/3d",
    "tests/docs/core",
    "examples/3d",
    "examples/core",
    "scripts/build/native"
  ]
}
