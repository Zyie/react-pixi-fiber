{
  "compilerOptions": {
    "target": "esnext",
    // DOM and WebGPU types come from `@types/web`, matching pixi-3d. Adding "DOM" here clashes with it.
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "@types/web", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    // No verbatimModuleSyntax: the vendored r3f source in src/r3f imports types without `import type`.
    // oxlint's consistent-type-imports holds our own files to type-only imports instead.
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./src/*"],
      // Tests, examples and docs import the library by its package name.
      "react-pixi-fiber": ["./src/index.tsx"],
      // r3f's alias for its types folder, used throughout the vendored source.
      "#types": ["./src/r3f/types/index.ts"],
      "#types/*": ["./src/r3f/types/*"],
      // pixi-3d isn't on npm; we build against its source in .repos (npm run sync:repos).
      "@pixi/3d": ["./.repos/pixi-3d/src/index.ts"],
      "@pixi/3d/extras": ["./.repos/pixi-3d/src/extras/index.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "*.config.ts"],
  // src/r3f is type-checked through what src imports from it. Its own entries (index, legacy, webgpu)
  // each declare three's JSX elements, which would clash with ours.
  "exclude": ["node_modules", "dist", "src/r3f/**", ".repos/**/*.worker.ts"]
}
