{
  "compilerOptions": {
    "target": "esnext",
    // DOM and WebGPU types come from `@types/web`, matching pixi-3d. Adding "DOM" here clashes with it.
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "@types/web", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    // No verbatimModuleSyntax: the vendored r3f source in src/r3f imports types without `import type`.
    // oxlint's consistent-type-imports holds our own files to type-only imports instead.
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./src/*"],
      // Scenes, examples, the playground and docs import the library by its package name.
      "react-pixi-fiber": ["./src/index.tsx"],
      "react-pixi-fiber/three": ["./src/three.ts"],
      "react-pixi-fiber/addons": ["./src/addons/index.ts"],
      // r3f's alias for its types folder, used throughout the vendored source.
      "#types": ["./src/r3f/types/index.ts"],
      "#types/*": ["./src/r3f/types/*"],
      "@test-scene": ["./tests/harness/scene.ts"],
      "@test-utils": ["./tests/harness/test-utils.tsx"]
    }
  },
  "include": ["src", "tests", "examples", "playground", "scripts", "*.config.ts"],
  // src/r3f is type-checked through what src imports from it. Its own entries (index, legacy, webgpu)
  // each declare three's JSX elements, which would clash with ours.
  "exclude": ["node_modules", "dist", "src/r3f/**"]
}
